# Virtual environments
.venv/
venv/
env/
ENV/

# Python caches & artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
.eggs/

# Build / dist
build/
dist/
pip-wheel-metadata/

# Tools caches
.pytest_cache/
.mypy_cache/
.tox/
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Env files (secrets)
.env
*.env

# Dagster local run state (transient, machine-specific)
.dagster_home/
.tmp_dagster_home_*/

# Excel lock files (created while a workbook is open)
~$*.xlsx

# Local backup copy of the private bs_optimization submodule — NEVER commit
# (contains the private LabBank-Optimization source; a stray `git add .` would
#  publish it). Keep working backups outside the repo, or under this name.
bs_optimization.bak/

# Root-level scratch dirs (module-level output dirs like optimize_prep/output/
# are tracked and unaffected by these anchored patterns)
/output/
/tmp/

# draw.io autosave / backup / lock files
*.bkp
.$*.drawio

# visual_rep scratch dumps (notebook cell captures during report auditing)
visual_rep/cell_*.txt
visual_rep/scan*.txt

# Copyrighted reference material - never commit, cite only
Diogo Gobira*.pdf

# Notebook-exported HTML reports: regenerate from the tracked .ipynb via
# visual_rep/export_report.py, bs_optimization/notebooks/export_optimization_report.py,
# or `jupyter nbconvert --to html <notebook>.ipynb` -- not tracked to avoid
# committing duplicate rendered output alongside the notebook source.
# (Hand-authored HTML like docs/*.html and optimize_prep/method_b_explainer.html
# is unaffected -- only these specific notebook-export paths are ignored.)
visual_rep/ALM_report.html
visual_rep/finance_report.html
bs_optimization/notebooks/optimization_report.html
bs_optimization/notebooks/optimization_report_clean.html