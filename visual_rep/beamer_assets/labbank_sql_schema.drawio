          vertex="1" parent="1">
          <mxGeometry x="270" y="310" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cf_t" value="products  (contractual + behavioural CF schedule for loans / deposits / instruments)&lt;br&gt;───────────────&lt;br&gt;🔑 schedule_id · product_type · cf_start_dt&lt;br&gt;product_code · currency · bs_side · rate_index&lt;br&gt;cf_end_dt · cf_yf · d_f · fwd_rt · client_rt · margin&lt;br&gt;con_outstanding · con_capital_pmt · con_interest_pmt&lt;br&gt;beh_outstanding · beh_capital_pmt · beh_interest_pmt&lt;br&gt;comp_capital_pmt · comp_interest_pmt · prepayment_pmt&lt;br&gt;&lt;br&gt;ir_swap_orig  ·  ir_swap_beh   (IRS CF schedules — same column layout)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="cf">
          <mxGeometry x="0" y="24" width="560" height="176" as="geometry" />
        </mxCell>

        <!-- ═══ ROW 3: IRRBB ═══ -->

        <!-- irrbb -->
        <mxCell id="irrbb" value="&lt;b&gt;irrbb&lt;/b&gt;"
          style="swimlane;startSize=22;fillColor=#B71C1C;strokeColor=#7F0000;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="580" width="780" height="200" as="geometry" />
        </mxCell>
        <mxCell id="irrbb_t" value="ir_gap_beh  ·  ir_gap_beh_a   (repricing gaps: contractual + behavioural + IRS overlay)&lt;br&gt;ir_swap_gap_beh   (IRS contribution to gap, from ir_derivatives)&lt;br&gt;───────────────&lt;br&gt;nii_base_scenario   — NII calculation per (product, tenor, scenario)&lt;br&gt;    Columns: beh_outstanding · client_rt · fwd_rt · margin · nii_interest · nii_renewal · nii_total&lt;br&gt;&lt;br&gt;nii_results   — aggregated NII per (scenario, currency): base_nii · delta_nii · delta_nii_pct&lt;br&gt;shocked_curves   — 6 EBA + own shock curves applied to each currency&lt;br&gt;eve_results   — EVE per (scenario, currency, tenor bucket): cf_pmt · d_f_base · d_f_shocked · delta_pv · delta_eve&lt;br&gt;irrbb_report   — summary SOT table: ΔEVE_reg / T1 · ΔNII_reg / T1 · SOT breach flags"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="irrbb">
          <mxGeometry x="0" y="24" width="780" height="176" as="geometry" />
        </mxCell>

        <!-- results -->
        <mxCell id="res" value="&lt;b&gt;results&lt;/b&gt;"
          style="swimlane;startSize=22;fillColor=#E65100;strokeColor=#BF360C;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="830" y="580" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="res_t" value="irrbb_report&lt;br&gt;───────────────&lt;br&gt;scenario · currency&lt;br&gt;delta_eve · delta_eve_reg · sot_eve_pct · sot_eve_pct_reg&lt;br&gt;delta_nii · delta_nii_reg · sot_nii_pct · sot_nii_pct_reg&lt;br&gt;&lt;br&gt;lcr_nsfr&lt;br&gt;───────────────&lt;br&gt;currency · hqla · net_outflow · lcr&lt;br&gt;asf · rsf · nsfr · report_date"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="res">
          <mxGeometry x="0" y="24" width="300" height="176" as="geometry" />
        </mxCell>

        <!-- opt_prep -->
        <mxCell id="opt" value="&lt;b&gt;opt_prep&lt;/b&gt;"
          style="swimlane;startSize=22;fillColor=#37474F;strokeColor=#263238;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="1150" y="580" width="210" height="200" as="geometry" />
        </mxCell>
        <mxCell id="opt_t" value="curves_tensor&lt;br&gt;───────────────&lt;br&gt;Vectorised shocked curves&lt;br&gt;per (scenario, tenor)&lt;br&gt;&lt;br&gt;product_params&lt;br&gt;───────────────&lt;br&gt;Per-product sensitivity params&lt;br&gt;&lt;br&gt;*.npz files — NumPy arrays&lt;br&gt;for fast NII/EVE approximation"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="opt">
          <mxGeometry x="0" y="24" width="210" height="176" as="geometry" />
        </mxCell>

        <!-- ═══ FLOW ARROWS ═══ -->

        <!-- dbo → schemat (FK) -->
        <mxCell id="e_dbo_sch" value="FK: transaction_id" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1A237E;strokeWidth=2;endArrow=block;endFill=1;fontSize=8;fontColor=#1A237E;" edge="1" source="dbo" target="sch" parent="1">
          <mxGeometry relative="1" as="geometry" />
