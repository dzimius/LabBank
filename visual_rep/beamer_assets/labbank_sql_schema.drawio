        <mxCell id="e_sch_sched" value="schedule_id" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#1A237E;strokeWidth=2;endArrow=block;endFill=1;fontSize=8;fontColor=#1A237E;" edge="1" source="sch" target="sched" parent="1">
