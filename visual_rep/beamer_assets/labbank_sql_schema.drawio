<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram id="labbank-sql" name="SQL Schema Data Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ TITLE ═══ -->
        <mxCell id="title" value="LabBank  —  SQL Data Model  (9 schemas)"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1A237E;"
          vertex="1" parent="1">
          <mxGeometry x="0" y="8" width="1400" height="32" as="geometry" />
        </mxCell>

        <!-- ═══ ROW 1: Balance Sheet schemas ═══ -->

        <!-- dbo.transactions -->
        <mxCell id="dbo" value="&lt;b&gt;dbo&lt;/b&gt;"
          style="swimlane;startSize=22;fillColor=#1A237E;strokeColor=#0d1b72;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="220" height="178" as="geometry" />
        </mxCell>
        <mxCell id="dbo_t" value="transactions&lt;br&gt;───────────────&lt;br&gt;🔑 transaction_id&lt;br&gt;product_code · product_name&lt;br&gt;bs_side  (A / L)&lt;br&gt;balance_amt · currency&lt;br&gt;client_id · client_type_id"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="dbo">
          <mxGeometry x="0" y="24" width="220" height="154" as="geometry" />
        </mxCell>

        <!-- schemat -->
        <mxCell id="sch" value="&lt;b&gt;schemat&lt;/b&gt;"
          style="swimlane;startSize=22;fillColor=#1A237E;strokeColor=#0d1b72;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="310" height="178" as="geometry" />
        </mxCell>
        <mxCell id="sch_t" value="loans  ·  deposits  ·  financial_instruments&lt;br&gt;equity  ·  ir_swaps&lt;br&gt;───────────────&lt;br&gt;↳ transaction_id  (FK → dbo.transactions)&lt;br&gt;rate_type  (F / V / A)&lt;br&gt;client_rt · index_rt · margin&lt;br&gt;start_date · maturity_date&lt;br&gt;disc_curve · fwd_curve&lt;br&gt;schedule_id  (FK → sched.*)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="sch">
          <mxGeometry x="0" y="24" width="310" height="154" as="geometry" />
        </mxCell>

        <!-- mkt -->
        <mxCell id="mkt" value="&lt;b&gt;mkt&lt;/b&gt;"
          style="swimlane;startSize=22;fillColor=#4527A0;strokeColor=#311B92;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="230" height="178" as="geometry" />
        </mxCell>
        <mxCell id="mkt_t" value="curves&lt;br&gt;───────────────&lt;br&gt;curve_date · curve_name&lt;br&gt;tenor · year_frac · zero_rate · d_f&lt;br&gt;currency&lt;br&gt;&lt;br&gt;fixings&lt;br&gt;───────────────&lt;br&gt;fixing_date · rate_index&lt;br&gt;tenor · rate · currency"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="mkt">
          <mxGeometry x="0" y="24" width="230" height="154" as="geometry" />
        </mxCell>

        <!-- bs -->
        <mxCell id="bs" value="&lt;b&gt;bs&lt;/b&gt;"
          style="swimlane;startSize=22;fillColor=#4527A0;strokeColor=#311B92;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="240" height="178" as="geometry" />
        </mxCell>
        <mxCell id="bs_t" value="models_loan&lt;br&gt;───────────────&lt;br&gt;product_code · tenor · prep_rate&lt;br&gt;&lt;br&gt;models_deposit_ir&lt;br&gt;───────────────&lt;br&gt;product_code · tenor · outstanding&lt;br&gt;&lt;br&gt;models_deposit_liq&lt;br&gt;(same structure, LIQ horizon)"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="bs">
          <mxGeometry x="0" y="24" width="240" height="154" as="geometry" />
        </mxCell>

        <!-- sched -->
        <mxCell id="sched" value="&lt;b&gt;sched&lt;/b&gt;"
          style="swimlane;startSize=22;fillColor=#1565C0;strokeColor=#0D47A1;fontColor=#ffffff;fontSize=11;fontStyle=1;arcSize=4;"
          vertex="1" parent="1">
          <mxGeometry x="1110" y="60" width="250" height="178" as="geometry" />
        </mxCell>
        <mxCell id="sched_t" value="Schedule-ID bridge tables&lt;br&gt;───────────────&lt;br&gt;One row per unique (product, tenor,&lt;br&gt;currency, rate_type) group.&lt;br&gt;Links schemat transactions to&lt;br&gt;CF generation in cf.products.&lt;br&gt;&lt;br&gt;schedule_id  (PK)&lt;br&gt;product_code · rate_type · currency"
          style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=9;verticalAlign=top;spacingLeft=6;"
          vertex="1" parent="sched">
          <mxGeometry x="0" y="24" width="250" height="154" as="geometry" />
        </mxCell>

        <!-- ═══ ROW 2: CF ═══ -->

        <!-- cf -->
        <mxCell id="cf" value="&lt;b&gt;cf&lt;/b&gt;"
