        <mxCell id="e_cf_irrbb" value="beh CFs → gap · NII · EVE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#00695C;strokeWidth=2;endArrow=block;endFill=1;fontSize=8;fontColor=#00695C;" edge="1" source="cf" target="irrbb" parent="1">
          <mxGeometry relative="1" as="geometry" />
