  <diagram id="labbank-transaction-erd" name="Transaction ERD">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1120" pageHeight="880" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ TITLE ═══ -->
        <mxCell id="title" value="LabBank  —  Core Entity Relationships  (dbo.transactions hub)"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A237E;"
          vertex="1" parent="1">
          <mxGeometry x="0" y="6" width="1120" height="38" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One row per position in dbo.transactions; each schemat.* table adds product-specific detail for the same transaction_id&lt;br&gt;(1:1 — every position belongs to exactly one product table)."
          style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;"
