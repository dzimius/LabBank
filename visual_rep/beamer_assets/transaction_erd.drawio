        <mxCell id="c_loans" value="" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;rounded=0;strokeColor=#1565C0;strokeWidth=3;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub" target="loans">
